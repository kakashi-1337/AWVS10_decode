#include constants.inc;
#include helpers.inc;
#include secret_detection.inc;

var file = getCurrentFile();
if (!file) ScriptAbort();

var body = file.response.body;
if (!body || body.length < 10) ScriptAbort();

var maxScan = 500000;
if (body.length > maxScan) body = body.substring(0, maxScan);

var contentType = file.response.headerValue("Content-Type") || "";
var isBinary = (contentType.indexOf("image/") != -1 ||
    contentType.indexOf("audio/") != -1 ||
    contentType.indexOf("video/") != -1 ||
    contentType.indexOf("font/") != -1 ||
    contentType.indexOf("application/octet-stream") != -1 ||
    contentType.indexOf("application/zip") != -1 ||
    contentType.indexOf("application/pdf") != -1);
if (isBinary) ScriptAbort();

// --- Scan body for secrets ---
var secrets = scanForSecrets(body);
for (var i = 0; i < secrets.length; i++) {
    var s = secrets[i];
    var ri = new TReportItem();
    ri.LoadFromFile("Application_Error.xml");
    ri.affects = file.fullPath;
    ri.alertPath = "Scripts/SecretScanner";

    if (s.severity >= 4) {
        ri.name = "CRITICAL: " + s.name + " Exposed";
    } else if (s.severity >= 3) {
        ri.name = "HIGH: " + s.name + " Detected";
    } else {
        ri.name = s.name + " Found";
    }

    ri.severity = s.severity;
    ri.request = file.request.headersString;
    ri.response = file.response.headersString;
    ri.details = s.name + " found in response body.[break]" +
        "Value (truncated): [pre]" + s.value.substring(0, 40) + "...[/pre][break]" +
        "Position: offset " + s.position;
    AddReportItem(ri);
}

// --- Scan body for crypto keys/certs ---
var cryptoFindings = scanForCryptoKeys(body);
for (var i = 0; i < cryptoFindings.length; i++) {
    var c = cryptoFindings[i];
    var ri = new TReportItem();
    ri.LoadFromFile("Application_Error.xml");
    ri.affects = file.fullPath;
    ri.alertPath = "Scripts/SecretScanner";
    ri.name = c.name + " Exposed in Page";
    ri.severity = c.severity;
    ri.request = file.request.headersString;
    ri.response = file.response.headersString;
    ri.details = c.name + " found in response body.[break]" +
        "Preview: [pre]" + c.value + "[/pre]";
    AddReportItem(ri);
}

// --- Scan body for JWT tokens ---
var jwtFindings = scanForJWTPayloads(body);
for (var i = 0; i < jwtFindings.length; i++) {
    var j = jwtFindings[i];
    var ri = new TReportItem();
    ri.LoadFromFile("Application_Error.xml");
    ri.affects = file.fullPath;
    ri.alertPath = "Scripts/SecretScanner";
    ri.name = "JWT Token in Page Source";
    ri.severity = j.severity;
    ri.request = file.request.headersString;
    ri.response = file.response.headersString;
    ri.details = "JWT token found in response body.[break]" +
        "Token: [pre]" + j.value + "[/pre][break]" +
        j.details;
    AddReportItem(ri);
}

// --- Scan response headers ---
var headerFindings = scanResponseHeaders(file.response);
for (var i = 0; i < headerFindings.length; i++) {
    var h = headerFindings[i];
    var ri = new TReportItem();
    ri.LoadFromFile("Application_Error.xml");
    ri.affects = file.fullPath;
    ri.alertPath = "Scripts/SecretScanner";
    ri.name = h.name;
    ri.severity = h.severity;
    ri.request = file.request.headersString;
    ri.response = file.response.headersString;
    ri.details = h.name + ": [pre]" + h.value + "[/pre]";
    AddReportItem(ri);
}

// --- Enhanced email extraction ---
var emails = extractAllEmails(body);
if (emails.length > 0) {
    for (var i = 0; i < emails.length; i++) {
        addEmailAddressesForLaterUsage(emails[i].replace(/ \(.*\)$/, ""));
    }

    var ri = new TReportItem();
    ri.LoadFromFile("Application_Error.xml");
    ri.affects = file.fullPath;
    ri.alertPath = "Scripts/SecretScanner";
    ri.name = "Email Addresses Discovered (" + emails.length + ")";
    ri.severity = 1;
    ri.request = file.request.headersString;
    ri.response = file.response.headersString;
    var detail = "Email addresses found:[break]";
    var max = Math.min(emails.length, 25);
    for (var i = 0; i < max; i++) {
        detail += "[pre]" + emails[i] + "[/pre][break]";
    }
    if (emails.length > 25) detail += "...and " + (emails.length - 25) + " more";
    ri.details = detail;
    AddReportItem(ri);
}
