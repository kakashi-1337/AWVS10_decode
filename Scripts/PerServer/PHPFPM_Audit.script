#include constants.inc;
#include helpers.inc;

var targetUrl = new TURL(scanURL.url);

// PHP-FPM misconfigurations, known CVEs, path info disclosure

function testPHPFPMStatus() {
    var statusPaths = [
        "/status",
        "/fpm-status",
        "/php-fpm-status",
        "/phpfpm_status",
        "/status?full",
        "/fpm-status?full",
    ];

    for (var i = 0; i < statusPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = statusPaths[i];
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            if (body.indexOf("pool:") != -1 || body.indexOf("process manager") != -1 ||
                body.indexOf("accepted conn") != -1 || body.indexOf("listen queue") != -1) {

                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = statusPaths[i];
                ri.alertPath = "Scripts/PHP-FPM";
                ri.name = "PHP-FPM Status Page Exposed";
                ri.severity = 2;
                ri.setHttpInfo(job);
                ri.details = "PHP-FPM status page accessible at [bold]" + statusPaths[i] + "[/bold].[break]" +
                    "Exposes: pool name, process manager type, active/idle workers, " +
                    "total requests served, request duration, memory usage per worker.[break]" +
                    "With ?full: individual request URIs, execution times, and client IPs.";
                AddReportItem(ri);
                break;
            }
        }
    }
}

function testPHPFPMPing() {
    var pingPaths = ["/ping", "/fpm-ping", "/php-fpm-ping"];

    for (var i = 0; i < pingPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = pingPaths[i];
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            if (body.indexOf("pong") != -1) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = pingPaths[i];
                ri.alertPath = "Scripts/PHP-FPM";
                ri.name = "PHP-FPM Ping Endpoint Active";
                ri.severity = 1;
                ri.setHttpInfo(job);
                ri.details = "PHP-FPM ping endpoint responds at [bold]" + pingPaths[i] + "[/bold].[break]" +
                    "Confirms PHP-FPM is running and helps fingerprint the backend.";
                AddReportItem(ri);
                break;
            }
        }
    }
}

function testPHPFPMCVE202011724() {
    // CVE-2019-11043 - PHP-FPM RCE via path_info (only with specific nginx misconfig)
    // Requires: try_files not used, fastcgi_split_path_info with regex
    // Test: send path_info that causes buffer underread

    var testPaths = [
        "/index.php/PHP%0Ais_fun",
        "/index.php/%0a",
        "/index.php/path%0Dinfo",
        "/index.php/test%0d%0a",
        "/index.php/%0d%0atest",
    ];

    for (var i = 0; i < testPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = testPaths[i];
        job.execute();

        if (!job.wasError) {
            var body = job.response.body;
            // look for signs that path_info is being split incorrectly
            if (body.indexOf("PHP_VALUE") != -1 || body.indexOf("php_value") != -1 ||
                body.indexOf("auto_prepend") != -1 || body.indexOf("allow_url_include") != -1) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = testPaths[i];
                ri.alertPath = "Scripts/PHP-FPM";
                ri.name = "PHP-FPM Path Info RCE (CVE-2019-11043)";
                ri.severity = 4;
                ri.setHttpInfo(job);
                ri.details = "PHP-FPM processes manipulated PATH_INFO with newline injection.[break]" +
                    "CVE-2019-11043 enables RCE by injecting PHP_VALUE directives via buffer underflow.[break]" +
                    "Requires nginx with fastcgi_split_path_info and missing try_files.";
                AddReportItem(ri);
                break;
            }

            // secondary detection: different error behavior with newlines
            if (job.response.msg2 == 502 || job.response.msg2 == 503) {
                var normalJob = new THTTPJob();
                normalJob.url = targetUrl;
                normalJob.URI = "/index.php/normalpath";
                normalJob.execute();

                if (!normalJob.wasError && normalJob.response.msg2 != 502 && normalJob.response.msg2 != 503) {
                    var ri = new TReportItem();
                    ri.LoadFromFile("Application_Error.xml");
                    ri.affects = testPaths[i];
                    ri.alertPath = "Scripts/PHP-FPM";
                    ri.name = "PHP-FPM Potential CVE-2019-11043 - Path Info Anomaly";
                    ri.severity = 3;
                    ri.setHttpInfo(job);
                    ri.details = "PHP-FPM crashes (502/503) when processing newline in PATH_INFO.[break]" +
                        "Normal path returns " + normalJob.response.msg2 + ", but newline path returns " + job.response.msg2 + ".[break]" +
                        "This behavior pattern matches CVE-2019-11043 susceptibility.";
                    AddReportItem(ri);
                    break;
                }
            }
        }
    }
}

function testPHPInfo() {
    var phpinfoPaths = [
        "/phpinfo.php", "/info.php", "/php_info.php", "/test.php",
        "/i.php", "/pi.php", "/php.php", "/_phpinfo.php",
        "/debug.php", "/temp.php", "/old.php",
    ];

    for (var i = 0; i < phpinfoPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = phpinfoPaths[i];
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            if (body.indexOf("phpinfo()") != -1 || body.indexOf("PHP Version") != -1 ||
                body.indexOf("Configuration File") != -1) {
                var details = "phpinfo() page accessible at [bold]" + phpinfoPaths[i] + "[/bold].[break]";

                // extract useful info
                if (body.indexOf("DOCUMENT_ROOT") != -1) details += "Document root exposed.[break]";
                if (body.indexOf("SERVER_ADMIN") != -1) details += "Server admin email exposed.[break]";
                if (body.indexOf("disable_functions") != -1) details += "Disabled functions list visible.[break]";
                if (body.indexOf("open_basedir") != -1) details += "open_basedir configuration visible.[break]";
                if (body.indexOf("SMTP") != -1) details += "SMTP configuration visible.[break]";

                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = phpinfoPaths[i];
                ri.alertPath = "Scripts/PHP-FPM";
                ri.name = "PHP Info Page Exposed";
                ri.severity = 2;
                ri.setHttpInfo(job);
                ri.details = details;
                AddReportItem(ri);
                break;
            }
        }
    }
}

function testPHPSensitive() {
    // PHP-specific dangerous files
    var paths = [
        { path: "/adminer.php", desc: "Adminer DB management", sev: 4 },
        { path: "/phpmyadmin/", desc: "phpMyAdmin", sev: 2 },
        { path: "/pma/", desc: "phpMyAdmin (alt)", sev: 2 },
        { path: "/myadmin/", desc: "phpMyAdmin (alt)", sev: 2 },
        { path: "/mysql/", desc: "MySQL admin", sev: 2 },
        { path: "/wp-config.php.bak", desc: "WP config backup", sev: 4 },
        { path: "/config.php.bak", desc: "config backup", sev: 4 },
        { path: "/.user.ini", desc: "PHP user config", sev: 2 },
        { path: "/php.ini", desc: "PHP config", sev: 3 },
    ];

    for (var i = 0; i < paths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = paths[i].path;
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            var report = false;

            if (paths[i].path.indexOf("adminer") != -1 && body.indexOf("Adminer") != -1) report = true;
            if (paths[i].path.indexOf("phpmyadmin") != -1 && body.indexOf("phpMyAdmin") != -1) report = true;
            if (paths[i].path.indexOf("pma") != -1 && body.indexOf("phpMyAdmin") != -1) report = true;
            if (paths[i].path.indexOf(".user.ini") != -1 && body.indexOf("=") != -1 && body.length < 5000) report = true;
            if (paths[i].path.indexOf("php.ini") != -1 && body.indexOf("[PHP]") != -1) report = true;
            if (paths[i].path.indexOf(".bak") != -1 && body.indexOf("<?php") != -1) report = true;

            if (report) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = paths[i].path;
                ri.alertPath = "Scripts/PHP-FPM";
                ri.name = "PHP Sensitive File: " + paths[i].desc;
                ri.severity = paths[i].sev;
                ri.setHttpInfo(job);
                ri.details = "Sensitive PHP file accessible: [bold]" + paths[i].path + "[/bold]";
                AddReportItem(ri);
            }
        }
    }
}

testPHPFPMStatus();
testPHPFPMPing();
testPHPFPMCVE202011724();
testPHPInfo();
testPHPSensitive();
