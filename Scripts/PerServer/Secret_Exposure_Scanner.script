// Content validators for each probe type
function validateProbe(path, body, statusCode) {
    if (statusCode != 200) return false;
    if (!body || body.length < 5) return false;
    if (body.indexOf("<!DOCTYPE") == 0 || body.indexOf("<html") == 0) {
        if (body.indexOf("404") != -1 || body.indexOf("Not Found") != -1) return false;
        if (body.indexOf("Forbidden") != -1 || body.indexOf("403") != -1) return false;
    }

    // .env files
    if (path.indexOf(".env") != -1) {
        return (body.indexOf("=") != -1 &&
            (body.indexOf("KEY") != -1 || body.indexOf("SECRET") != -1 ||
             body.indexOf("PASSWORD") != -1 || body.indexOf("DB_") != -1 ||
             body.indexOf("APP_") != -1 || body.indexOf("API_") != -1 ||
             body.indexOf("TOKEN") != -1 || body.indexOf("MAIL_") != -1 ||
             body.indexOf("AWS_") != -1 || body.indexOf("REDIS_") != -1));
    }

    // Git files
    if (path.indexOf(".git/config") != -1) return body.indexOf("[core]") != -1 || body.indexOf("[remote") != -1;
    if (path.indexOf(".git/HEAD") != -1) return body.indexOf("ref:") == 0;
    if (path.indexOf(".git/logs") != -1) return body.indexOf("commit") != -1;

    // SSH/crypto keys
    if (path.indexOf("id_rsa") != -1 || path.indexOf("private") != -1 || path.indexOf(".key") != -1 || path.indexOf(".pem") != -1) {
        return body.indexOf("-----BEGIN") != -1;
    }
    if (path.indexOf("authorized_keys") != -1) return body.indexOf("ssh-") != -1;

    // Cloud credentials
    if (path.indexOf("credentials") != -1 || path.indexOf("service-account") != -1 || path.indexOf("firebase") != -1) {
        return (body.indexOf("private_key") != -1 || body.indexOf("aws_access_key") != -1 ||
            body.indexOf("client_email") != -1 || body.indexOf("project_id") != -1);
    }

    // Docker config
    if (path.indexOf(".docker/config") != -1) return body.indexOf("auth") != -1;

    // Configs
    if (path.indexOf("config.json") != -1) return body.indexOf("{") == 0 && body.length > 20;
    if (path.indexOf("config.yaml") != -1 || path.indexOf("config.yml") != -1) return body.indexOf(":") != -1 && body.length > 20;
    if (path.indexOf("settings.py") != -1) return body.indexOf("SECRET_KEY") != -1 || body.indexOf("DATABASES") != -1;
    if (path.indexOf("database.yml") != -1) return body.indexOf("adapter") != -1 || body.indexOf("password") != -1;
    if (path.indexOf(".npmrc") != -1) return body.indexOf("registry") != -1 || body.indexOf("_auth") != -1;
    if (path.indexOf("configuration.php") != -1) return body.indexOf("<?php") != -1 || body.indexOf("password") != -1;

    // SQL dumps
    if (path.indexOf(".sql") != -1) {
        return (body.indexOf("CREATE TABLE") != -1 || body.indexOf("INSERT INTO") != -1 ||
            body.indexOf("DROP TABLE") != -1 || body.indexOf("-- MySQL") != -1 ||
            body.indexOf("-- PostgreSQL") != -1);
    }

    // Logs
    if (path.indexOf(".log") != -1 || path.indexOf("log/") != -1) {
        return (body.indexOf("[error]") != -1 || body.indexOf("[Error]") != -1 ||
            body.indexOf("Exception") != -1 || body.indexOf("Stack trace") != -1 ||
            body.indexOf("CRITICAL") != -1 || body.indexOf("[warning]") != -1 ||
            body.indexOf("PHP Fatal") != -1 || body.indexOf("Traceback") != -1);
    }

    // Spring Actuator
    if (path.indexOf("actuator") != -1 || path.indexOf("manage/env") != -1) {
        return body.indexOf("{") == 0 || body.indexOf("_links") != -1 || body.indexOf("activeProfiles") != -1;
    }

    // Debug endpoints
    if (path.indexOf("_profiler") != -1) return body.indexOf("profiler") != -1 || body.indexOf("Symfony") != -1;
    if (path.indexOf("_debugbar") != -1) return body.indexOf("debugbar") != -1;
    if (path.indexOf("debug/vars") != -1) return body.indexOf("{") == 0;
    if (path.indexOf("debug/pprof") != -1) return body.indexOf("profile") != -1;
    if (path.indexOf("server-status") != -1) return body.indexOf("Apache") != -1;
    if (path.indexOf("server-info") != -1) return body.indexOf("Apache") != -1;
    if (path.indexOf("nginx_status") != -1) return body.indexOf("Active connections") != -1;
    if (path.indexOf("metrics") != -1) return body.indexOf("# HELP") != -1 || body.indexOf("# TYPE") != -1;

    // GraphQL
    if (path.indexOf("graphql") != -1 || path.indexOf("graphiql") != -1 || path.indexOf("playground") != -1) {
        return body.indexOf("graphql") != -1 || body.indexOf("GraphQL") != -1 || body.indexOf("__schema") != -1;
    }

    // Source maps
    if (path.indexOf(".map") != -1) return body.indexOf("mappings") != -1 || body.indexOf("sources") != -1;

    // CI configs
    if (path.indexOf(".travis") != -1 || path.indexOf("circleci") != -1 || path.indexOf("gitlab-ci") != -1) {
        return body.indexOf(":") != -1 && body.length > 20;
    }

    // Package files
    if (path.indexOf("package.json") != -1) return body.indexOf("name") != -1 && body.indexOf("version") != -1;
    if (path.indexOf("composer.lock") != -1) return body.indexOf("packages") != -1;

    // Index listing
    if (body.indexOf("Index of") != -1) return true;

    return body.length > 10 && body.length < 500000;
}

// Run probes
for (var i = 0; i < probePaths.length; i++) {
    var probe = probePaths[i];
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = probe.path;
    job.execute();

    if (!job.wasError && validateProbe(probe.path, job.response.body, job.response.msg2)) {
        var body = job.response.body;

        // Deep-scan the exposed content for actual secrets
        var secrets = scanForSecrets(body);
        var cryptoKeys = scanForCryptoKeys(body);
        var jwts = scanForJWTPayloads(body);
        var emails = extractAllEmails(body);

        // Report the exposed path itself
        var ri = new TReportItem();
        ri.LoadFromFile("Application_Error.xml");
        ri.affects = probe.path;
        ri.alertPath = "Scripts/SecretScanner";
        ri.name = "Exposed: " + probe.desc;
        ri.severity = probe.sev;
        ri.setHttpInfo(job);

        var detail = "Sensitive file accessible: [bold]" + probe.path + "[/bold][break]";

        if (secrets.length > 0) {
            detail += "[break][bold]Secrets found in content:[/bold][break]";
            for (var s = 0; s < secrets.length && s < 10; s++) {
                detail += "- " + secrets[s].name + ": [pre]" + secrets[s].value.substring(0, 30) + "...[/pre][break]";
            }
            ri.severity = 4;
        }

        if (cryptoKeys.length > 0) {
            detail += "[break][bold]Cryptographic material found:[/bold][break]";
            for (var c = 0; c < cryptoKeys.length && c < 5; c++) {
                detail += "- " + cryptoKeys[c].name + "[break]";
            }
            if (cryptoKeys[0].severity > ri.severity) ri.severity = cryptoKeys[0].severity;
        }

        if (jwts.length > 0) {
            detail += "[break][bold]JWT tokens found:[/bold][break]";
            for (var j = 0; j < jwts.length && j < 5; j++) {
                detail += "- " + jwts[j].details + "[break]";
            }
        }

        if (emails.length > 0) {
            detail += "[break][bold]Email addresses (" + emails.length + "):[/bold][break]";
            for (var e = 0; e < emails.length && e < 10; e++) {
                detail += "- " + emails[e] + "[break]";
                addEmailAddressesForLaterUsage(emails[e].replace(/ \(.*\)$/, ""));
            }
        }

        ri.details = detail;
        AddReportItem(ri);
    }
}

// Probe GraphQL introspection for schema leak
var gqlJob = new THTTPJob();
gqlJob.url = targetUrl;
gqlJob.URI = "/graphql";
gqlJob.verb = "POST";
gqlJob.postData = '{"query":"{ __schema { types { name fields { name } } } }"}';
gqlJob.request.addHeader("Content-Type", "application/json");
gqlJob.execute();

if (!gqlJob.wasError && gqlJob.response.msg2 == 200) {
    var gqlBody = gqlJob.response.body;
    if (gqlBody.indexOf("__schema") != -1 && gqlBody.indexOf("types") != -1) {
        var ri = new TReportItem();
        ri.LoadFromFile("Application_Error.xml");
        ri.affects = "/graphql";
        ri.alertPath = "Scripts/SecretScanner";
        ri.name = "GraphQL Introspection Enabled";
        ri.severity = 2;
        ri.setHttpInfo(gqlJob);
        ri.details = "GraphQL introspection query returns full schema.[break]" +
            "Exposes all types, fields, queries, mutations, and subscriptions.[break]" +
            "Attackers can map the entire API surface.";
        AddReportItem(ri);
    }
}

// Check .well-known paths for info leak
var wellKnownPaths = [
    { path: "/.well-known/security.txt", desc: "Security contact" },
    { path: "/.well-known/openid-configuration", desc: "OpenID config" },
    { path: "/.well-known/jwks.json", desc: "JWT key set" },
    { path: "/.well-known/apple-app-site-association", desc: "Apple app association" },
    { path: "/.well-known/assetlinks.json", desc: "Android asset links" },
];

for (var i = 0; i < wellKnownPaths.length; i++) {
    var wk = wellKnownPaths[i];
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = wk.path;
    job.execute();

    if (!job.wasError && job.response.msg2 == 200 && job.response.body.length > 10) {
        var body = job.response.body;

        if (wk.path.indexOf("jwks") != -1 && body.indexOf("keys") != -1) {
            var ri = new TReportItem();
            ri.LoadFromFile("Application_Error.xml");
            ri.affects = wk.path;
            ri.alertPath = "Scripts/SecretScanner";
            ri.name = "JWKS Public Key Set Exposed";
            ri.severity = 1;
            ri.setHttpInfo(job);
            ri.details = "JSON Web Key Set accessible.[break]" +
                "Verify private keys are not included (look for 'd', 'p', 'q', 'dp', 'dq', 'qi' parameters).[break]" +
                "If present, attacker can forge JWT tokens.";

            if (body.indexOf('"d"') != -1 || body.indexOf('"p"') != -1 || body.indexOf('"qi"') != -1) {
                ri.name = "CRITICAL: JWKS Contains Private Key Parameters";
                ri.severity = 4;
                ri.details = "JWKS endpoint exposes PRIVATE key parameters (d, p, q, dp, dq, qi).[break]" +
                    "Attacker can forge arbitrary JWT tokens with any claims.";
            }
            AddReportItem(ri);
        }

        if (wk.path.indexOf("security.txt") != -1) {
            var emails = extractAllEmails(body);
            for (var e = 0; e < emails.length; e++) {
                addEmailAddressesForLaterUsage(emails[e].replace(/ \(.*\)$/, ""));
            }
        }
    }
}
