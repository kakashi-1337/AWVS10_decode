#include constants.inc;
#include helpers.inc;

var targetUrl = new TURL(scanURL.url);

// WordPress REST API user enumeration, XML-RPC attacks, plugin/theme exposure

function testWPDetection() {
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = "/";
    job.execute();

    if (job.wasError) return false;
    var body = job.response.body;
    return (body.indexOf("wp-content") != -1 || body.indexOf("wp-includes") != -1 ||
            body.indexOf("wordpress") != -1 || body.indexOf("wp-json") != -1);
}

function testWPUserEnum() {
    // REST API user enumeration (WP >= 4.7)
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = "/wp-json/wp/v2/users";
    job.execute();

    if (!job.wasError && job.response.msg2 == 200) {
        var body = job.response.body;
        if (body.indexOf("slug") != -1 && body.indexOf("name") != -1) {
            var usernames = [];
            try {
                var users = JSON.parse(body);
                for (var i = 0; i < users.length; i++) {
                    usernames.push(users[i].slug || users[i].name);
                }
            } catch(e) {}

            var ri = new TReportItem();
            ri.LoadFromFile("Application_Error.xml");
            ri.affects = "/wp-json/wp/v2/users";
            ri.alertPath = "Scripts/WordPress";
            ri.name = "WordPress User Enumeration via REST API";
            ri.severity = 2;
            ri.setHttpInfo(job);
            ri.details = "WordPress REST API exposes user information.[break]" +
                (usernames.length > 0 ? "Discovered users: " + usernames.join(", ") + "[break]" : "") +
                "Enables targeted brute-force and social engineering attacks.";
            AddReportItem(ri);
        }
    }

    // author parameter enumeration
    for (var n = 1; n <= 10; n++) {
        var job2 = new THTTPJob();
        job2.url = targetUrl;
        job2.URI = "/?author=" + n;
        job2.execute();

        if (!job2.wasError && (job2.response.msg2 == 301 || job2.response.msg2 == 302)) {
            var location = job2.response.headerValue("Location");
            if (location && location.indexOf("/author/") != -1) {
                var username = location.split("/author/")[1];
                if (username) {
                    username = username.replace(/\/$/, "");
                    var ri = new TReportItem();
                    ri.LoadFromFile("Application_Error.xml");
                    ri.affects = "/?author=" + n;
                    ri.alertPath = "Scripts/WordPress";
                    ri.name = "WordPress User Enumeration via Author Parameter";
                    ri.severity = 2;
                    ri.setHttpInfo(job2);
                    ri.details = "User enumerated via author redirect: [bold]" + username + "[/bold] (ID: " + n + ")";
                    AddReportItem(ri);
                    break;
                }
            }
        }
    }
}

function testXMLRPC() {
    var job = new THTTPJob();
    job.url = targetUrl;
    job.URI = "/xmlrpc.php";
    job.verb = "POST";
    job.postData = '<?xml version="1.0"?><methodCall><methodName>system.listMethods</methodName></methodCall>';
    job.request.addHeader("Content-Type", "text/xml");
    job.execute();

    if (!job.wasError && job.response.msg2 == 200) {
        var body = job.response.body;
        if (body.indexOf("methodResponse") != -1) {
            var methods = [];
            if (body.indexOf("wp.getUsersBlogs") != -1) methods.push("wp.getUsersBlogs (brute-force)");
            if (body.indexOf("pingback.ping") != -1) methods.push("pingback.ping (SSRF/DDoS)");
            if (body.indexOf("system.multicall") != -1) methods.push("system.multicall (amplified brute-force)");
            if (body.indexOf("wp.getOptions") != -1) methods.push("wp.getOptions (info disclosure)");

            var ri = new TReportItem();
            ri.LoadFromFile("Application_Error.xml");
            ri.affects = "/xmlrpc.php";
            ri.alertPath = "Scripts/WordPress";
            ri.name = "WordPress XML-RPC Enabled";
            ri.severity = 3;
            ri.setHttpInfo(job);
            ri.details = "XML-RPC interface is enabled and accessible.[break]" +
                "Available dangerous methods:[break]" + methods.join("[break]") + "[break][break]" +
                "system.multicall allows testing thousands of passwords in a single HTTP request.[break]" +
                "pingback.ping can be used for SSRF and DDoS amplification.";
            AddReportItem(ri);
        }
    }
}

function testWPConfig() {
    var configPaths = [
        "/wp-config.php",
        "/wp-config.php.bak",
        "/wp-config.php.old",
        "/wp-config.php.save",
        "/wp-config.php.swp",
        "/wp-config.php~",
        "/wp-config.bak",
        "/wp-config.txt",
        "/wp-config.php.orig",
        "/.wp-config.php.swp",
    ];

    for (var i = 0; i < configPaths.length; i++) {
        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = configPaths[i];
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            if (body.indexOf("DB_NAME") != -1 || body.indexOf("DB_PASSWORD") != -1 ||
                body.indexOf("table_prefix") != -1 || body.indexOf("AUTH_KEY") != -1) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = configPaths[i];
                ri.alertPath = "Scripts/WordPress";
                ri.name = "WordPress Configuration File Exposed";
                ri.severity = 4;
                ri.setHttpInfo(job);
                ri.details = "WordPress configuration backup file accessible at [bold]" + configPaths[i] + "[/bold].[break]" +
                    "Contains database credentials, authentication keys, table prefix, and debug settings.";
                AddReportItem(ri);
                break;
            }
        }
    }
}

function testWPSensitivePaths() {
    var paths = [
        { path: "/wp-admin/install.php", desc: "WP installer", sev: 4 },
        { path: "/wp-content/debug.log", desc: "PHP debug log", sev: 3 },
        { path: "/wp-content/uploads/", desc: "uploads directory listing", sev: 1 },
        { path: "/wp-includes/", desc: "includes directory listing", sev: 1 },
        { path: "/readme.html", desc: "WP version disclosure", sev: 1 },
        { path: "/license.txt", desc: "WP license (confirms WP)", sev: 0 },
        { path: "/wp-cron.php", desc: "WP cron endpoint", sev: 1 },
        { path: "/wp-json/", desc: "REST API root", sev: 1 },
        { path: "/wp-json/wp/v2/settings", desc: "WP settings API", sev: 3 },
        { path: "/wp-json/wp/v2/search?search=admin", desc: "REST search", sev: 1 },
        { path: "/wp-admin/admin-ajax.php", desc: "AJAX handler", sev: 0 },
        { path: "/?rest_route=/wp/v2/users", desc: "alt REST user enum", sev: 2 },
    ];

    for (var i = 0; i < paths.length; i++) {
        if (paths[i].sev == 0) continue;

        var job = new THTTPJob();
        job.url = targetUrl;
        job.URI = paths[i].path;
        job.execute();

        if (!job.wasError && job.response.msg2 == 200) {
            var body = job.response.body;
            var report = false;

            if (paths[i].path.indexOf("install.php") != -1 && body.indexOf("install") != -1 && body.indexOf("WordPress") != -1) report = true;
            if (paths[i].path.indexOf("debug.log") != -1 && (body.indexOf("PHP") != -1 || body.indexOf("error") != -1)) report = true;
            if (paths[i].path.indexOf("readme.html") != -1 && body.indexOf("WordPress") != -1) report = true;
            if (paths[i].path.indexOf("settings") != -1 && body.indexOf("title") != -1) report = true;
            if (paths[i].desc.indexOf("directory listing") != -1 && body.indexOf("Index of") != -1) report = true;

            if (report) {
                var ri = new TReportItem();
                ri.LoadFromFile("Application_Error.xml");
                ri.affects = paths[i].path;
                ri.alertPath = "Scripts/WordPress";
                ri.name = "WordPress: " + paths[i].desc;
                ri.severity = paths[i].sev;
                ri.setHttpInfo(job);
                ri.details = "WordPress sensitive path accessible: [bold]" + paths[i].path + "[/bold]";
                AddReportItem(ri);
            }
        }
    }
}

if (testWPDetection()) {
    testWPUserEnum();
    testXMLRPC();
    testWPConfig();
    testWPSensitivePaths();
}
